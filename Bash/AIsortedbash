# =============================================================================
# 1. CORE SYSTEM SETTINGS
# =============================================================================
export TERM="xterm-256color"
export HISTCONTROL=erasedups:ignoredups:ignorespace
export HISTTIMEFORMAT=" %d/%m/%y %T "

# Set nvim as the default manpager for better reading
export MANPAGER="nvim +Man!"

# Enable vi mode in terminal
set -o vi
bind -m vi-command 'Control-l: clear-screen'
bind -m vi-insert 'Control-l: clear-screen'

# =============================================================================
# 2. PATH EXPORTS
# =============================================================================
[[ -d "$HOME/.bin" ]] && PATH="$HOME/.bin:$PATH"
[[ -d "$HOME/.local/bin" ]] && PATH="$HOME/.local/bin:$PATH"
[[ -d "$HOME/.cargo/bin" ]] && PATH="$HOME/.cargo/bin:$PATH"
[[ -d "/var/lib/flatpak/exports/bin/" ]] && PATH="/var/lib/flatpak/exports/bin/:$PATH"
[[ -d "/.local/share/flatpak/exports/bin" ]] && PATH="/.local/share/flatpak/exports/bin:$PATH"

bind "set completion-ignore-case on"

# =============================================================================
# 3. ALIASES: SAFETY & BASICS
# =============================================================================
# Stop yourself from accidentally deleting/overwriting files
alias rm='rm -i'
alias cp='cp -i'
alias mv='mv -i'

# Simplified list commands (You only really need these 3)
alias ls='ls -aFh --color=always'  # Standard colored list
alias ll='ls -lah --color=always'  # Long list (permissions, hidden files)
alias lt='ls -ltrh'                # Sort by newest last (great for logs)

alias cls='clear'
alias vim="nvim"
alias grep='grep --color=auto'

# =============================================================================
# 4. ALIASES: NAVIGATION SPEED-BOOSTERS
# =============================================================================
alias ..='cd ..'
alias ...='cd ../..'
alias ..2='cd ../../..'
alias bd='cd "$OLDPWD"'            # Go back to the last directory you were in

# Reload bashrc easily
alias sbrc="source ~/.bashrc && echo 'Bashrc reloaded!'"
alias ebrc="nvim ~/.bashrc"

# =============================================================================
# 5. DEBIAN PACKAGE MANAGEMENT
# =============================================================================
alias update='sudo apt update && sudo apt upgrade -y'
alias install='sudo apt install -y'
alias search='apt search'
alias purge='sudo apt purge'

# =============================================================================
# 6. SYSTEM DIAGNOSTICS & LOG HUNTERS
# =============================================================================
# Replace complex journalctl commands with easy words
alias sysfails='systemctl --failed'
alias syserrors='journalctl -p 3 -xb'
alias sysauth='journalctl -u ssh.service -u sudo -f'
alias openports='netstat -nape --inet'

# GPU Controls
alias gpu-int='sudo envycontrol -s integrated'
alias gpu-hyb='sudo envycontrol -s hybrid --rtd3'
alias gpu-nvd='sudo envycontrol -s nvidia --force-comp --coolbits 24'

# =============================================================================
# 7. CUSTOM FUNCTIONS (FILE OPS & EXTRACTION)
# =============================================================================
# Create a folder AND go into it immediately
mkdirg() {
    mkdir -p "$1" && cd "$1"
}

# Copy a file to a folder AND go into that folder
cpg() {
    cp "$1" "$2" && cd "$2"
}

# Move a file to a folder AND go into that folder
mvg() {
    mv "$1" "$2" && cd "$2"
}

# Universal Extractor: Extracts ANY archive format
ex() {
    if [ -f "$1" ]; then
        case $1 in
            *.tar.bz2)   tar xjf "$1"   ;;
            *.tar.gz)    tar xzf "$1"   ;;
            *.bz2)       bunzip2 "$1"   ;;
            *.rar)       unrar x "$1"   ;;
            *.gz)        gunzip "$1"    ;;
            *.tar)       tar xf "$1"    ;;
            *.zip)       unzip "$1"     ;;
            *.7z)        7z x "$1"      ;;
            *.tar.xz)    tar xf "$1"    ;;
            *.tar.zst)   unzstd "$1"    ;;
            *.deb)       ar x "$1"      ;;
            *)           echo "'$1' cannot be extracted via ex()" ;;
        esac
    else
        echo "'$1' is not a valid file"
    fi
}

