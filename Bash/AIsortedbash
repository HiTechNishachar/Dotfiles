# =============================================================================
# 1. CORE SYSTEM SETTINGS
# =============================================================================
export TERM="xterm-256color"
export HISTCONTROL=erasedups:ignoredups:ignorespace
export HISTTIMEFORMAT=" %d/%m/%y %T "

# Set nvim as the default manpager for better reading
export MANPAGER="nvim +Man!"

# Enable vi mode in terminal
set -o vi
bind -m vi-command 'Control-l: clear-screen'
bind -m vi-insert 'Control-l: clear-screen'

# Enable bash programmable completion features
if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
fi

# =============================================================================
# 2. PATH EXPORTS
# =============================================================================
[[ -d "$HOME/.bin" ]] && PATH="$HOME/.bin:$PATH"
[[ -d "$HOME/.local/bin" ]] && PATH="$HOME/.local/bin:$PATH"
[[ -d "$HOME/.cargo/bin" ]] && PATH="$HOME/.cargo/bin:$PATH"
[[ -d "/var/lib/flatpak/exports/bin/" ]] && PATH="/var/lib/flatpak/exports/bin/:$PATH"
[[ -d "/.local/share/flatpak/exports/bin" ]] && PATH="/.local/share/flatpak/exports/bin:$PATH"

bind "set completion-ignore-case on"

# =============================================================================
# 3. ALIASES: SAFETY & BASICS
# =============================================================================
# Ensure aliases expand properly when using sudo
alias sudo='sudo '

alias rm='rm -i'
alias cp='cp -i'
alias mv='mv -i'

alias ls='ls -aFh --color=always'
alias ll='ls -lah --color=always'
alias lt='ls -ltrh'

alias cls='clear'
alias vim="nvim"
alias grep='grep --color=auto'

# =============================================================================
# 4. ALIASES: NAVIGATION SPEED-BOOSTERS
# =============================================================================
alias ..='cd ..'
alias ...='cd ../..'
alias .3='cd ../../..'
alias bd='cd "$OLDPWD"'

alias sbrc="source ~/.bashrc && echo 'Bashrc reloaded!'"
alias ebrc="nvim ~/.bashrc"

# =============================================================================
# 5. DEBIAN PACKAGE MANAGEMENT
# =============================================================================
alias update='sudo apt update && sudo apt upgrade -y'
alias install='sudo apt install -y'
alias search='apt search'
alias purge='sudo apt purge'

# =============================================================================
# 6. SYSTEM DIAGNOSTICS & MANUAL GPU TOGGLES
# =============================================================================
alias sysfails='systemctl --failed'
alias syserrors='journalctl -p 3 -xb'
alias sysauth='journalctl -u ssh.service -u sudo -f'
alias openports='netstat -nape --inet'

# Disable NVIDIA GPU entirely (Max Battery)
gpu-off() {
    echo -e "\n[\e[31mDisabling NVIDIA GPU\e[0m] Writing manual blacklists..."
    sudo sh -c 'echo -e "blacklist nouveau\nblacklist nvidia\nblacklist nvidia_drm\nblacklist nvidia_modeset" > /etc/modprobe.d/disable-nvidia.conf'
    sudo sh -c 'echo "ACTION==\"add\", SUBSYSTEM==\"pci\", ATTR{vendor}==\"0x10de\", ATTR{class}==\"0x030000\", ATTR{remove}=\"1\"" > /etc/udev/rules.d/00-disable-nvidia.rules'
    sudo update-initramfs -u
    echo -e "Done. \e[1;33mPlease reboot to apply.\e[0m\n"
}

# Enable NVIDIA GPU (Gaming / Heavy 3D)
gpu-on() {
    echo -e "\n[\e[32mEnabling NVIDIA GPU\e[0m] Removing manual blacklists..."
    sudo rm -f /etc/modprobe.d/disable-nvidia.conf
    sudo rm -f /etc/udev/rules.d/00-disable-nvidia.rules
    sudo update-initramfs -u
    echo -e "Done. \e[1;33mPlease reboot to apply.\e[0m\n"
}

# =============================================================================
# 7. CUSTOM FUNCTIONS (FILE OPS & EXTRACTION)
# =============================================================================
mkdirg() {
    mkdir -p "$1" && cd "$1"
}

cpg() {
    cp "$1" "$2" && cd "$2"
}

mvg() {
    mv "$1" "$2" && cd "$2"
}

ex() {
    if [ -f "$1" ]; then
        case $1 in
            *.tar.bz2)   tar xjf "$1"   ;;
            *.tar.gz)    tar xzf "$1"   ;;
            *.bz2)       bunzip2 "$1"   ;;
            *.rar)       unrar x "$1"   ;;
            *.gz)        gunzip "$1"    ;;
            *.tar)       tar xf "$1"    ;;
            *.zip)       unzip "$1"     ;;
            *.7z)        7z x "$1"      ;;
            *.tar.xz)    tar xf "$1"    ;;
            *.tar.zst)   unzstd "$1"    ;;
            *.deb)       ar x "$1"      ;;
            *)           echo "'$1' cannot be extracted via ex()" ;;
        esac
    else
        echo "'$1' is not a valid file"
    fi
}

