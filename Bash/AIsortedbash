# The Fast System Dashboard
sysinfo() {
    echo -e "\n\e[1m=======================================================================\e[0m"
    echo -e "\e[1;36m 🐧 DEBIAN SYSTEM DASHBOARD \e[0m"
    echo -e "\e[1m=======================================================================\e[0m"
    
    local OS=$(grep "^PRETTY_NAME=" /etc/os-release | cut -d '=' -f 2 | tr -d '"')
    local KERNEL=$(uname -r)
    local UPTIME=$(uptime -p | sed 's/up //')
    
    echo -e "[OS]      : $OS"
    echo -e "[Kernel]  : $KERNEL"
    echo -e "[Uptime]  : $UPTIME"
    echo "-----------------------------------------------------------------------"
    
    local CPU=$(lscpu | grep "Model name:" | head -n 1 | sed -r 's/Model name:\s{1,}//g')
    local MEM_TOTAL=$(free -h | awk '/^Mem:/ {print $2}')
    local MEM_USED=$(free -h | awk '/^Mem:/ {print $3}')
    
    echo -e "[CPU]     : $CPU"
    echo -e "[Memory]  : $MEM_USED / $MEM_TOTAL in use"
    
    local DISK_USE=$(df -h / | awk 'NR==2 {print $5}')
    local DISK_AVAIL=$(df -h / | awk 'NR==2 {print $4}')
    
    if [ "${DISK_USE%?}" -gt 85 ]; then
        echo -e "\e[31m[Disk]    : / is at $DISK_USE (Only $DISK_AVAIL free!) - WARNING\e[0m"
    else
        echo -e "[Disk]    : / is at $DISK_USE ($DISK_AVAIL available)"
    fi
    echo -e "\e[1m=======================================================================\e[0m\n"
}

